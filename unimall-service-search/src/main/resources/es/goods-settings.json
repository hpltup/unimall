{
  "analysis": {
    "analyzer": {
      "ik_pinyin_analyzer": {
        "type": "custom",
        "tokenizer": "ik_max_word",
        "filter": [
          "my_pinyin",
          "lowercase"
        ]
      }
    },
    "filter": {
      "my_pinyin": {
        "type": "pinyin",
        "keep_full_pinyin": false,
        "keep_first_letter": true,
        "keep_joined_full_pinyin": true,
        "keep_original": true,
        "limit_first_letter_length": 16,
        "lowercase": true
      }
    }
  }
}
