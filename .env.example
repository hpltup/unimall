# UniMall Docker 部署环境变量示例
# 使用：复制本文件为 .env（同目录），填入实际值

# ===== 必填 =====

# gitee 私人令牌：config 服务拉取私有配置仓库（unimall-config-dev）用
# 获取：gitee -> 设置 -> 私人令牌（需勾选 projects 读取权限）
GITEE_TOKEN=your_gitee_private_token

# Nacos 地址：Nacos 运行在 Windows 宿主机，这里填虚拟机(192.168.89.101)能访问到的 Windows 宿主 IP
# 注意：容器内 127.0.0.1 指向容器自身，必须用宿主 IP。IP 以虚拟机网络实际为准：
#   - NAT 模式：通常是 192.168.89.2 或 192.168.89.1（虚拟机网关）
#   - 桥接模式：Windows 在 192.168.89.x 段的本机 IP
NACOS_ADDR=192.168.89.1:8848

# MySQL 地址：MySQL 同样运行在 Windows 宿主机（3306），填宿主 IP
# 前置：MySQL 需允许远程连接（root 允许 '%' host）+ Windows 防火墙放行 3306
MYSQL_HOST=192.168.89.1

# ===== 可选 =====

# DeepSeek API Key：AI 客服模块用；不填则 AI 服务可启动但对话鉴权失败(401)
DEEPSEEK_API_KEY=
